      "operators": [
        "add",
        "subtract",
        "multiply",
        "divide"
      ],
      "sampling_rule": "deterministic hash-ordered, round-robin class-balanced selection up to capacity; prefer at most one question per source document, relaxing that only if the fold is still short of capacity",
